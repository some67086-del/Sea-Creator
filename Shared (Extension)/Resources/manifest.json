{
  "manifest_version": 2,
  "name": "Sea Creator",
  "version": "1.0",
  "description": "A starter Safari web extension.",
  "background": { "scripts": ["background.js"] },
  "browser_action": { "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["*://*/*"], "js": ["content.js"] }],
  "permissions": ["activeTab"]
}
